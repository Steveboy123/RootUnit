# Copy to .env — loaded automatically by `npm run dev` and `npm start`.
#
# Demo mode (a simulated car, phones and music) is NOT a setting: it exists only when the server is started with the --demo
# flag, which `npm run dev` does and `npm start` / the systemd service never do. Nothing in this file can turn it on.

# --- Server ---------------------------------------------------------------
# Loopback only by default (the API can change volume/settings, so it has no
# business being reachable from the car's Wi-Fi). To use it from another
# device set HOST=0.0.0.0 AND list that device's hostname in HEADUNIT_ALLOWED_HOSTS.
# WARNING: there is no login. Anyone who can reach the port can change settings and control
# the head unit; the Host/Origin checks only stop web pages, not other devices. Read
# docs/pi-setup.md ("Network access") before exposing it, especially on the phone-projection Wi-Fi.
# HOST=127.0.0.1
# PORT=8787
# HEADUNIT_ALLOWED_HOSTS=car.local

# Leave this OFF on the Pi. It is only for development with the Vite dev server (`npm run dev`, UI on :5173):
# after a Spotify/TIDAL sign-in the browser is sent back to that address. In production the UI is served by this
# server itself, the default ("/") is right, and setting it would strand the kiosk on a dead page after sign-in.
# HEADUNIT_UI_URL=http://127.0.0.1:5173/

# --- Spotify ----------------------------------------------------------------
# See docs/setup.md and docs/spotify.md. You only need the Client ID (no API key, no Client secret).
# The easy way: Settings > Music services on the screen, or `npm run setup`. What you enter there is saved
# in data/credentials.json and takes precedence over the values in this file.
SPOTIFY_CLIENT_ID=
# Must exactly match a Redirect URI in your Spotify app. Spotify requires https
# or a loopback IP literal — "localhost" is rejected.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8787/auth/spotify/callback
# Name of the Spotify Connect device provided by the Pi itself.
# SPOTIFY_DEVICE_NAME=RPI Headunit
# Native librespot is the primary Spotify Connect path at 320 kbps; the official Web Playback SDK is fallback.
SPOTIFY_CONNECT_DISABLED=0
# Advanced audio routing (defaults are normally correct):
# SPOTIFY_CONNECT_BACKEND=alsa
# SPOTIFY_CONNECT_DEVICE=default
# SPOTIFY_CONNECT_BITRATE=320
# SPOTIFY_CONNECT_NORMALIZE=0
# SPOTIFY_CONNECT_FORMAT=

# --- TIDAL -------------------------------------------------------------------
# See docs/setup.md and docs/tidal.md. TIDAL catalog/search uses OAuth Client Credentials,
# so it needs BOTH the Client ID and Client Secret. The easiest setup is Music > TIDAL > Setup.
# Saved Settings values take precedence over these environment values.
# TIDAL_CLIENT_ID=
# TIDAL_CLIENT_SECRET=
# Optional account OAuth callback. Personal account sign-in is not required for catalog search/playback.
# TIDAL_REDIRECT_URI=http://127.0.0.1:8787/auth/tidal/callback
# Optional account OAuth permissions (scopes), separated by spaces. Empty = the built-in player list ("user.read playback").
# The v2 API has scopes such as collection.read and playlists.read for your TIDAL collection and playlists. Enable them
# for your app in the TIDAL developer dashboard FIRST (asking for a scope your app does not have can make the account
# sign-in fail), then list them here (or in Settings > Music services > TIDAL > Permissions) and sign in again.
# Example: TIDAL_SCOPES=user.read playback collection.read playlists.read
# TIDAL_SCOPES=
# Country (two letters) that TIDAL uses to decide what is available, e.g. DE. Empty = the country of the signed-in
# TIDAL account when there is one, else US.
# TIDAL_COUNTRY=

# --- YouTube Music -----------------------------------------------------------
# Optional: YouTube Data API v3 key. You can also enter this from Music > YouTube Music > Setup,
# which saves it locally and takes priority over this value.
# YOUTUBE_API_KEY=

# --- Phones / devices ---------------------------------------------------------
# The head unit uses BlueZ directly on the Raspberry Pi. No simulator provider is available.

# --- Volume / brightness / sound output ---------------------------------------
# The head unit uses PipeWire (wpctl) and brightnessctl when the display exposes hardware brightness.

# --- Wallpapers ---------------------------------------------------------------------
# Pictures you drop in this folder (png, jpg, jpeg, webp, avif; up to 12 MB each) can be chosen in
# Settings > Appearance > Background > Wallpaper. Default: data/wallpapers/ (next to settings.json).
# The app only reads the folder; create it yourself. See docs/setup.md.
# HEADUNIT_WALLPAPER_DIR=/home/pi/rpi-head-unit/data/wallpapers

# --- Vehicle data (OBD-II) -------------------------------------------------------
# See docs/obd.md. Configure a real ELM327-compatible Bluetooth/USB/Wi-Fi adapter.
# OBD_PORT=/dev/rfcomm0        # Pi + paired Bluetooth adapter; COM5 on Windows; tcp://host:port for Wi-Fi adapters
# OBD_BAUD=38400

# --- Android Auto / wired USB projection -----------------------------------
# Phone is a USB host-connected Android device (not an ADB developer-server bridge).
# A genuine wired USB Android Auto native receiver is REQUIRED. Do not use
# deploy/openauto-runtime.sh; that launcher runs the wireless-only Prodigy receiver.
# PROJECTION_COMMAND=/usr/local/bin/your-wired-receiver
PROJECTION_COMMAND=
PROJECTION_ARGS=
PROJECTION_MODE=ondemand
ANDROID_AUTO_DEV_ENABLED=0
# The receiver window is managed separately from the Chromium dashboard.
# PROJECTION_FOCUS_COMMAND='/path/to/deploy/focus-window.sh android-auto'
# PROJECTION_BACK_COMMAND='/path/to/deploy/focus-window.sh dashboard'
# --- Car Lab: GPS / WLED / dashcam -----------------------------------------
# DFRobot USB GPS uses gpsd on localhost TCP 2947; run deploy/setup-gps.sh.
# Lighting ESP32 IP and mode are saved in the dashboard.
# Optional token for ESP32 impact/motion/door sensor events:
HEADUNIT_SENSOR_TOKEN=

# --- FM transmitter (docs/fm.md) --------------------------------------------------
# Plays the head unit's sound on a car radio. The transmitter program needs a Raspberry Pi 0 to 4: this head unit (a Pi 5)
# cannot run it, so it talks to a small helper on a second Pi (or on itself when it is a Pi 4 or older).
# `sudo ./deploy/setup-fm.sh node` on that Pi prints the two lines below. Leave the token empty and FM stays off.
# This is a secret: it lives here only, never in settings, a backup or a screen.
# FM_NODE_TOKEN=
# The helper's control address. Default when a token is set: the helper on this Pi. Only http://, no path.
# FM_NODE_URL=http://192.168.1.50:8788
# The helper's sound port (default 8789) and what is recorded (default: whatever this head unit is playing).
# FM_NODE_AUDIO_PORT=8789
# FM_AUDIO_SOURCE=@DEFAULT_MONITOR@

# Optional REAL music-reactive beat meter: set to an ALSA CAPTURE device (not speaker output).
# Requires alsa-utils (arecord) and audio routed/mirrored to a loopback input.
# Find capture devices with: arecord -l
# HEADUNIT_BEAT_DEVICE=plughw:Loopback,1,0
