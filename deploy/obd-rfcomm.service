# Binds a paired Bluetooth OBD-II adapter to /dev/rfcomm0 at boot, so the app can open it like a serial port.
#   1. Pair first (see docs/obd.md), then find the address:  bluetoothctl devices
#   2. Put your adapter's address below (and its RFCOMM channel — almost always 1).
#   3. sudo cp deploy/obd-rfcomm.service /etc/systemd/system/
#      sudo systemctl daemon-reload && sudo systemctl enable --now obd-rfcomm
# "bind" doesn't connect yet: the link is made when the app opens /dev/rfcomm0, and retried automatically.
[Unit]
Description=Bluetooth OBD-II adapter on /dev/rfcomm0
After=bluetooth.service
Requires=bluetooth.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/rfcomm bind /dev/rfcomm0 AA:BB:CC:11:22:33 1
ExecStop=/usr/bin/rfcomm release /dev/rfcomm0

[Install]
WantedBy=multi-user.target
