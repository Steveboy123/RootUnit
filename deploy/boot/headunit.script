# Pi boot stage. labwc/Chromium show the matching HTML loading screen afterwards.
Window.SetBackgroundTopColor(0.015, 0.006, 0.028);
Window.SetBackgroundBottomColor(0.008, 0.004, 0.014);
mascot.image = Image("plymouth-mascot.png");
mascot.sprite = Sprite(mascot.image);
mascot.sprite.SetZ(5);
caption.image = Image("plymouth-title.png");
caption.sprite = Sprite(caption.image);
caption.sprite.SetZ(6);
frame = 0;
fun refresh_callback () {
  mascot.sprite.SetX((Window.GetWidth() - mascot.image.GetWidth()) / 2);
  mascot.sprite.SetY((Window.GetHeight() - mascot.image.GetHeight()) / 2 - 95);
  caption.sprite.SetX((Window.GetWidth() - caption.image.GetWidth()) / 2);
  caption.sprite.SetY((Window.GetHeight() + mascot.image.GetHeight()) / 2 - 85);
  frame += 0.045;
  mascot.sprite.SetOpacity(0.90 + 0.10 * Math.Sin(frame));
}
Plymouth.SetRefreshFunction(refresh_callback);
